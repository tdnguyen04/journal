generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Log {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  content    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  isRedacted Boolean  @default(false) // True if they typed /redacted
  tagValues  String[] @default([]) // Stores ["Empathy", "Growth"]

  // TIME BLOCKING
  startedAt DateTime  @default(now()) @db.Timestamptz(6)
  endedAt   DateTime? @db.Timestamptz(6)
  duration  Int? // Minutes

  // CONVERSATION STATE
  telegramChallengeId   String? @unique
  telegramChallengeType String? // "GAP_CONFIRM", "GAP_DURATION", "GAP_NAME"

  // DATA HYGIENE
  isGapFill Boolean @default(false)

  // EMOTIONAL CONTEXT (optional, user-provided via Telegram buttons)
  mood   String? // Values: "good", "okay", "low", or free text
  energy String? // Values: "high", "medium", "low", or free text

  // LIFECYCLE STATE (Business Logic)
  // "COMPLETED" = trustworthy
  // "TENTATIVE" = system assumption (time/gap guessed)
  status      String    @default("COMPLETED")

  @@map("logs")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model UserPreferences {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @unique @db.Uuid
  preferences    String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
  connectToken   String?  @unique
  telegramChatId String?  @unique
  userName       String?
  // DEPRECATED: We keep this for now so we don't break your existing UI immediately
  customValues   String[] @default(["Health", "Learning", "Connection", "Deep Work"])

  // Stores [{ name: "Learning", isGrowth: true }, ...]
  tags           Json?    @default("[]")

  // User's preferred timezone for Telegram bot time display (e.g., "America/New_York")
  timezone       String   @default("America/New_York")

  // Gap threshold (minutes) before asking about time - user configurable
  autoChainMinutes Int @default(15)

  @@map("user_preferences")
}
